# Copie este arquivo para .env e preencha os valores reais.
# .env está no .gitignore — nunca é commitado, nunca vai pro GitHub.
# NUNCA cole valores reais aqui, nem em nenhum arquivo versionado.

# Token do bot do Telegram, obtido do @BotFather (formato: 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=

# ID do chat pra onde as mensagens vão. Depois de configurar o token,
# rode: npm run telegram:chatid
# Isso lista os chats que já mandaram mensagem pro bot.
TELEGRAM_CHAT_ID=
