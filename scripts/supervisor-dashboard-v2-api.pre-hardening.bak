#!/usr/bin/env bash
# SUPERVISOR INDEPENDENTE DA API DO DASHBOARD 2.0 (Parte 4 — "Isolamento
# Real, Estabilidade e Transporte Incremental").
#
# Controla EXCLUSIVAMENTE `dashboard-v2/api/server.ts` — porta 5184. Nunca
# toca nenhum dos 8 processos do champion, nunca toca o Paper Profit Lab,
# nunca toca o dashboard antigo (porta 8787). Mesmo padrão de
# scripts/supervisor-profit-lab, propositalmente um script separado — não
# uma linha a mais em nenhum supervisor existente.
set -u
cd "$(dirname "$0")/.."
source scripts/lib/json-field.sh
# lock/mutex PRÓPRIOS deste supervisor -- nunca compartilhados com os
# outros 3.
export LOCK_FILE="dashboard-v2/api/logs/supervisor-api.lock"
export MUTEX_DIR="dashboard-v2/api/logs/supervisor-api.lockdir"
source scripts/lib/supervisor-lock.sh

PADRAO="dashboard-v2/api/server.ts"
CMD_LANCAMENTO="node --experimental-strip-types dashboard-v2/api/server.ts"
LOG_API="dashboard-v2/api/logs/api.log"
LOG_SUPERVISOR="dashboard-v2/api/logs/supervisor-log.jsonl"
LOG_SUPERVISOR_HUMANO="dashboard-v2/api/logs/supervisor-watchdog.log"
STATUS_FILE="dashboard-v2/api/logs/supervisor-status.json"
HEARTBEAT_FILE="dashboard-v2/api/logs/heartbeat.json"

INTERVALO_CHECAGEM_S=15
IDADE_MAXIMA_HEARTBEAT_S=30   # heartbeat próprio grava a cada 10s — 3x isso já é folgado
MAX_REINICIOS_15MIN=5
MAX_REINICIOS_24H=10

mkdir -p dashboard-v2/api/logs

falhas_consecutivas=0
ts_ms() { date +%s%3N; }
ts_legivel() { date '+%Y-%m-%dT%H:%M:%S%z'; }
log_humano() { echo "[$(date '+%H:%M:%S')] $1" >> "$LOG_SUPERVISOR_HUMANO"; }

reinicios_em_janela() {
  local janela_s="$1"
  [ -f "$LOG_SUPERVISOR" ] || { echo 0; return; }
  local agora_ms limite_ms
  agora_ms=$(ts_ms); limite_ms=$((agora_ms - janela_s * 1000))
  grep -o '"timestamp":[0-9]*' "$LOG_SUPERVISOR" 2>/dev/null | grep -o '[0-9]*' | awk -v lim="$limite_ms" '$1+0 >= lim' | wc -l | tr -d ' '
}

processo_vivo_com_padrao() {
  timeout 8 powershell -NoProfile -Command "@(Get-CimInstance Win32_Process -Filter \"Name='node.exe'\" | Where-Object { \$_.CommandLine -like '*server.ts*' -and \$_.CommandLine -like '*dashboard-v2*api*' }).Count" 2>/dev/null | tr -d '\r\n '
}
pid_vivo() {
  local pid="$1"; [ -z "$pid" ] && return 1
  timeout 8 powershell -NoProfile -Command "@(Get-CimInstance Win32_Process -Filter \"ProcessId=$pid\").Count" 2>/dev/null | tr -d '\r\n ' | grep -qx '1'
}
# ACHADO REAL (causava restart desnecessário a cada checagem, mesmo com a
# API saudável): a regex antiga aqui exigia dígito IMEDIATAMENTE depois dos
# dois-pontos, mas `JSON.stringify(..., null, 2)` sempre inclui um espaço
# ("pid": 123). Substituído por `scripts/lib/json-field.sh`, que usa
# `node -e` com `JSON.parse` de verdade -- nunca mais regex pra campo JSON.

registrar_evento() {
  local pid_anterior="$1" pid_novo="$2" motivo="$3" tentativa="$4" resultado="$5"
  printf '{"timestamp":%s,"timestampLegivel":"%s","pidAnterior":%s,"pidNovo":%s,"motivo":"%s","tentativa":%s,"resultado":"%s"}\n' \
    "$(ts_ms)" "$(ts_legivel)" "${pid_anterior:-null}" "${pid_novo:-null}" "$motivo" "$tentativa" "$resultado" >> "$LOG_SUPERVISOR"
}
escrever_status() {
  local status="$1" ultimo_reinicio="$2" motivo="$3" reinicios_24h="$4" falhas="$5" degradado="$6"
  local tmp="$STATUS_FILE.tmp"
  printf '{\n  "processo": "dashboard-v2-api",\n  "porta": 5184,\n  "statusSupervisor": "%s",\n  "ultimoReinicio": %s,\n  "motivoUltimoReinicio": "%s",\n  "reinicios24h": %s,\n  "falhasConsecutivas": %s,\n  "degradado": %s,\n  "atualizadoEm": %s\n}\n' \
    "$status" "${ultimo_reinicio:-null}" "$motivo" "$reinicios_24h" "$falhas" "$degradado" "$(ts_ms)" > "$tmp"
  mv "$tmp" "$STATUS_FILE"
}

lock_iniciar_ou_sair "$(pwd)/scripts/supervisor-dashboard-v2-api" "$LOG_SUPERVISOR_HUMANO" || exit 1

shutdown_limpo() {
  lock_liberar
  log_humano "supervisor-dashboard-v2-api: shutdown limpo — NÃO derruba a API V2, só para de supervisioná-la — lock liberado"
  escrever_status "parado" "" "supervisor encerrado manualmente" "$(reinicios_em_janela 86400)" "$falhas_consecutivas" "false"
  exit 0
}
trap shutdown_limpo INT TERM

log_humano "supervisor-dashboard-v2-api iniciado — checando a cada ${INTERVALO_CHECAGEM_S}s, exclusivo da API V2 (porta 5184)"
escrever_status "iniciando" "" "" "$(reinicios_em_janela 86400)" 0 "false"

while true; do
  lock_atualizar_heartbeat
  ultimo_hb_ms=$(ler_campo_json "$HEARTBEAT_FILE" "startedAt")
  ultima_req_ms=$(ler_campo_json "$HEARTBEAT_FILE" "ultimaRequisicao")
  pid_hb=$(ler_campo_json "$HEARTBEAT_FILE" "pid")
  agora_ms=$(ts_ms)

  # idade do heartbeat: usa mtime do arquivo (salvo a cada 10s pelo próprio
  # processo), não um campo interno — mais simples e não depende do formato
  idade_arquivo_s=""
  if [ -f "$HEARTBEAT_FILE" ]; then
    mtime_s=$(stat -c %Y "$HEARTBEAT_FILE" 2>/dev/null || stat -f %m "$HEARTBEAT_FILE" 2>/dev/null)
    [ -n "$mtime_s" ] && idade_arquivo_s=$(( $(date +%s) - mtime_s ))
  fi

  precisa_reiniciar=false
  motivo=""
  if [ ! -f "$HEARTBEAT_FILE" ]; then
    precisa_reiniciar=true; motivo="heartbeat.json inexistente — API V2 nunca subiu ou arquivo foi apagado"
  elif [ -z "$pid_hb" ] || ! pid_vivo "$pid_hb"; then
    precisa_reiniciar=true; motivo="PID $pid_hb do heartbeat não está mais vivo (crash provável)"
  elif [ -n "$idade_arquivo_s" ] && [ "$idade_arquivo_s" -gt "$IDADE_MAXIMA_HEARTBEAT_S" ]; then
    precisa_reiniciar=true; motivo="heartbeat parado há ${idade_arquivo_s}s, acima do limiar de ${IDADE_MAXIMA_HEARTBEAT_S}s"
  fi

  if [ "$precisa_reiniciar" = true ]; then
    reinicios_15min=$(reinicios_em_janela 900)
    reinicios_24h=$(reinicios_em_janela 86400)
    if [ "$reinicios_15min" -ge "$MAX_REINICIOS_15MIN" ] || [ "$reinicios_24h" -ge "$MAX_REINICIOS_24H" ]; then
      falhas_consecutivas=$((falhas_consecutivas + 1))
      log_humano "API V2 degradada — $reinicios_15min reinícios em 15min / $reinicios_24h em 24h — parando de tentar reiniciar sozinho"
      registrar_evento "$pid_hb" "" "$motivo (limite de reinícios atingido)" "$falhas_consecutivas" "degradado_sem_reiniciar"
      escrever_status "degradado" "" "$motivo" "$reinicios_24h" "$falhas_consecutivas" "true"
    else
      n_vivos=$(processo_vivo_com_padrao)
      if [ "${n_vivos:-0}" -ge 1 ] 2>/dev/null; then
        timeout 8 powershell -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name='node.exe'\" | Where-Object { \$_.CommandLine -like '*server.ts*' -and \$_.CommandLine -like '*dashboard-v2*api*' } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force -ErrorAction SilentlyContinue }" >/dev/null 2>&1
      fi
      nohup $CMD_LANCAMENTO >> "$LOG_API" 2>&1 &
      disown
      pid_novo=$!
      falhas_consecutivas=$((falhas_consecutivas + 1))
      reinicios_24h=$((reinicios_24h + 1))
      log_humano "API V2 reiniciada — motivo: $motivo — pidAnterior=$pid_hb pidNovo=$pid_novo"
      registrar_evento "$pid_hb" "$pid_novo" "$motivo" "$falhas_consecutivas" "reiniciado"
      escrever_status "reiniciando" "$(ts_ms)" "$motivo" "$reinicios_24h" "$falhas_consecutivas" "false"
    fi
  else
    falhas_consecutivas=0
    escrever_status "saudavel" "" "" "$(reinicios_em_janela 86400)" 0 "false"
  fi

  sleep "$INTERVALO_CHECAGEM_S"
done
